# Reflex — environment template (Rules §15.1: config via env only; NEVER commit real .env)
# Variable-by-variable guide: MANUAL_STEPS.md §3. Quickstart: README.md.

# --- Database (host port 15432: compose maps 15432->5432 to dodge Windows
#     excluded-port ranges that cover 5432; see MANUAL_STEPS.md §10) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=reflex_dev_pg
POSTGRES_DB=reflex
DATABASE_URL_ADMIN=postgresql+psycopg://postgres:reflex_dev_pg@localhost:15432/reflex
# Agent services use the locked-down role (cannot read replay.sim_* — ADR-004)
DATABASE_URL=postgresql+psycopg://reflex_agent:agent_dev_pw@localhost:15432/reflex
# Proof/eval role may read replay truth
DATABASE_URL_EVAL=postgresql+psycopg://reflex_eval:eval_dev_pw@localhost:15432/reflex

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=dev-only-change-me
JWT_TTL_HOURS=8

# --- Razorpay (TEST MODE ONLY — Rules §1.7; keys must start with rzp_test_) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- LLM provider (OpenAI-compatible). Absent/unreachable => degraded mode (Rules §15.2) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Runtime ---
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Cross-origin API base — REQUIRED for deployed builds.
# Without this, the bundle is same-origin and every /api call hits the
# static nginx server (POSTs become 405). Local dev: VITE_REFLEX_API=
# On Vercel set this as a Project Environment Variable (build) instead of .env.
VITE_REFLEX_API=https://reflex-api.antideploy.com
